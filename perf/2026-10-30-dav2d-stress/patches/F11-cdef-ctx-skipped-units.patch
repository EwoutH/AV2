+            dav2d_memset_pow2[splat_idx](cdef_ptr, -2);
+            if (bh4 >= 32) {
+                dav2d_memset_pow2[splat_idx](&cdef_ptr[4], -2);
+                if (bh4 == 64) {
+                    dav2d_memset_pow2[splat_idx](&cdef_ptr[8], -2);
+                    dav2d_memset_pow2[splat_idx](&cdef_ptr[12], -2);
+                }
+            }
+        }
     }
 
