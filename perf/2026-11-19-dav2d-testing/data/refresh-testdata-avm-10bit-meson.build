dav2d_test_args += ['--filmgrain=1']

tests = [
	['avm.mandel.200x112.l1.12bit.still-fg', files('avm.mandel.200x112.l1.12bit.still-fg.obu'), 'c45148d81384b0d2bb5d4d62dfc5b124'],
	['avm.mandel.200x112.l10.12bit.fg13', files('avm.mandel.200x112.l10.12bit.fg13.obu'), '6df447ade937dfa5e72fcd32e99874f9'],
	['avm.testsrc.130x74.l12.10bit.tile-rows2', files('avm.testsrc.130x74.l12.10bit.tile-rows2.obu'), 'bf8b336b83a062fb201db0d31688917d'],
	['avm.testsrc.130x74.l2.422.12bit', files('avm.testsrc.130x74.l2.422.12bit.obu'), '8456705b64bc0c67af81296bbcbf9f44'],
	['avm.testsrc.130x74.l20.10bit.resize9-fwdkf', files('avm.testsrc.130x74.l20.10bit.resize9-fwdkf.obu'), '5bf2b55262801ed11ac59ef582000a4f'],
	['avm.testsrc.130x74.l20.422.10bit.s1', files('avm.testsrc.130x74.l20.422.10bit.s1.obu'), 'c01a0026f6ddfb93cc17725c45006773'],
	['avm.testsrc.130x74.l4.10bit.sb256', files('avm.testsrc.130x74.l4.10bit.sb256.obu'), '54ae6a363e6c319ca8de091fde1c2d82'],
	['avm.testsrc.176x144.l1.12bit.still-screen', files('avm.testsrc.176x144.l1.12bit.still-screen.obu'), '40f8aae81e16ac9a0426f47d48fa533d'],
	['avm.bus.128x96.l8.10bit.s4', files('avm.bus.128x96.l8.10bit.s4.obu'), '7ba299fb8fe54b99c4f16494dd7f86c5'],
	['avm.bus.176x144.l2.10bit.qp208', files('avm.bus.176x144.l2.10bit.qp208.obu'), 'd498eb3771a7ab97284c7be929b24879'],
]

foreach test : tests
    test(test[0], dav2d, suite: ['avm', 'testdata'],
         args: dav2d_test_args + ['-i', test[1], '--verify', test[2]] +
               (test.length() > 3 ? test[3] : []))
endforeach
