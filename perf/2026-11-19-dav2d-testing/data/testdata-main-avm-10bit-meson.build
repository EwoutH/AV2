tests = [
	['avm.bus.128x96.l8.10bit.s4', files('avm.bus.128x96.l8.10bit.s4.obu'), '7ba299fb8fe54b99c4f16494dd7f86c5'],
	['avm.bus.176x144.l2.10bit.qp208', files('avm.bus.176x144.l2.10bit.qp208.obu'), 'd498eb3771a7ab97284c7be929b24879'],
]

foreach test : tests
    test(test[0], dav2d, suite: ['avm', 'testdata'],
         args: dav2d_test_args + ['-i', test[1], '--verify', test[2]])
endforeach
